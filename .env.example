# Copy to .env and fill in. .env is gitignored and must never be committed.

# Azure OpenAI — used by src/vlm_diagram_eval/llm/*
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Mermaid parser service (defaults match `make parser`)
PARSER_SERVICE_URL=http://localhost:9595
